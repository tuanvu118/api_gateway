{
  auto_https off
}

(common_site) {
  encode zstd gzip
  header {
    -Server
    -X-User-Id
    -X-User-Email
    -X-User-Roles
    -X-Unit-Id
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
  log {
    output stdout
    format console
  }
}

(auth_gateway) {
  forward_auth auth-gateway:8080 {
    uri /verify
    copy_headers X-User-Id X-User-Email X-User-Roles X-Unit-Id
  }
}

(app_proxy_common) {
  header_up Host {host}
  header_up X-Forwarded-Host {host}
  header_up X-Forwarded-Proto {scheme}
  header_up X-Forwarded-For {remote_host}
  transport http {
    dial_timeout 5s
    response_header_timeout 30s
    read_timeout 30s
    write_timeout 30s
  }
}

http://localhost {
  import common_site

  handle /api/auth/* {
    reverse_proxy be-service-api:8000 {
      import app_proxy_common
    }
  }

  handle /api/* {
    import auth_gateway
    reverse_proxy be-service-api:8000 {
      import app_proxy_common
    }
  }

  handle /qr/* {
    import auth_gateway
    reverse_proxy qr-service-api:8000 {
      import app_proxy_common
    }
  }

  handle {
    reverse_proxy frontend:80
  }
}

http://api.localhost {
  import common_site
  
  handle /api/auth/* {
    reverse_proxy be-service-api:8000 {
      import app_proxy_common
    }
  }

  handle {
    import auth_gateway
    reverse_proxy be-service-api:8000 {
      import app_proxy_common
    }
  }
}

http://qr.localhost {
  import common_site
  import auth_gateway
  reverse_proxy qr-service-api:8000 {
    import app_proxy_common
  }
}

http://rabbitmq.localhost {
  import common_site
  reverse_proxy rabbitmq:15672
}
